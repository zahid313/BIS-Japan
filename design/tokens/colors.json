{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "BIS Japan Color Tokens",
  "version": "1.0.0",
  "description": "Accessible semantic color system for bisjapan.org, balancing British academic heritage with Japanese childcare warmth.",
  "primitives": {
    "navy": {
      "50": "#EEF4FC",
      "100": "#D8E6F8",
      "200": "#B3CEF2",
      "300": "#84AFE8",
      "400": "#4F8ADC",
      "500": "#2563EB",
      "600": "#1D4ED8",
      "700": "#1B365D",
      "800": "#142A4A",
      "900": "#0D1D34",
      "950": "#07101E"
    },
    "crestLime": {
      "50": "#F7FAEB",
      "100": "#EDF5CE",
      "200": "#DDEBA0",
      "300": "#C7DF68",
      "400": "#B0D038",
      "500": "#9CBD30",
      "600": "#819E21",
      "700": "#647B1A",
      "800": "#4B5C14",
      "900": "#3C4A11"
    },
    "amber": {
      "50": "#FFFBEB",
      "100": "#FEF3C7",
      "200": "#FDE68A",
      "300": "#FCD34D",
      "400": "#FBBF24",
      "500": "#F59E0B",
      "600": "#D97706",
      "700": "#B45309",
      "800": "#92400E",
      "900": "#78350F"
    },
    "emerald": {
      "50": "#ECFDF5",
      "100": "#D1FAE5",
      "200": "#A7F3D0",
      "300": "#6EE7B7",
      "400": "#34D399",
      "500": "#10B981",
      "600": "#059669",
      "700": "#047857",
      "800": "#065F46",
      "900": "#064E3B"
    },
    "slate": {
      "50": "#FAFAF9",
      "100": "#F5F5F4",
      "200": "#E7E5E4",
      "300": "#D6D3D1",
      "400": "#A8A29E",
      "500": "#78716C",
      "600": "#57534E",
      "700": "#44403C",
      "800": "#292524",
      "900": "#1C1917"
    },
    "lineGreen": {
      "base": "#06C755",
      "hover": "#05B24C",
      "active": "#049D42",
      "light": "#E6F9EE"
    }
  },
  "semantic": {
    "background": {
      "canvas": {
        "value": "{primitives.slate.50}",
        "description": "Default page background (warm paper texture feeling)"
      },
      "surface": {
        "value": "#FFFFFF",
        "description": "Card, modal, and container background"
      },
      "surfaceSubtle": {
        "value": "{primitives.slate.100}",
        "description": "Secondary card and hover background"
      },
      "brandDark": {
        "value": "{primitives.navy.700}",
        "description": "Header, footer, and high-impact hero banners"
      },
      "brandDeep": {
        "value": "{primitives.navy.900}",
        "description": "Footer and deepest accent surfaces"
      },
      "warmHighlight": {
        "value": "{primitives.amber.50}",
        "description": "Subsidy callouts and special notice backgrounds"
      },
      "trustHighlight": {
        "value": "{primitives.emerald.50}",
        "description": "Safety badges and verified teacher card highlights"
      }
    },
    "text": {
      "primary": {
        "value": "{primitives.slate.900}",
        "contrastOnWhite": "14.2:1 (WCAG AAA)",
        "description": "Primary headers and high-emphasis body text"
      },
      "secondary": {
        "value": "{primitives.slate.700}",
        "contrastOnWhite": "7.8:1 (WCAG AAA)",
        "description": "Standard prose and explanatory copy"
      },
      "muted": {
        "value": "{primitives.slate.500}",
        "contrastOnWhite": "4.6:1 (WCAG AA)",
        "description": "Captions, dates, and non-critical notes"
      },
      "inverse": {
        "value": "#FFFFFF",
        "description": "Text rendered on dark navy backgrounds"
      },
      "inverseMuted": {
        "value": "{primitives.navy.200}",
        "description": "Secondary text on dark navy backgrounds"
      },
      "brand": {
        "value": "{primitives.navy.700}",
        "description": "Brand links and accent headings"
      },
      "accent": {
        "value": "{primitives.amber.700}",
        "description": "Highlighted pricing numbers and key stats"
      }
    },
    "border": {
      "subtle": {
        "value": "{primitives.slate.200}",
        "description": "Standard card borders and list separators"
      },
      "default": {
        "value": "{primitives.slate.300}",
        "description": "Form inputs and interactive containers"
      },
      "brand": {
        "value": "{primitives.navy.700}",
        "description": "Active borders and highlighted sections"
      },
      "focus": {
        "value": "{primitives.navy.500}",
        "description": "Accessible keyboard focus ring (minimum 3px outline)"
      }
    },
    "action": {
      "primary": {
        "background": "{primitives.amber.600}",
        "backgroundHover": "{primitives.amber.700}",
        "text": "#FFFFFF",
        "description": "Main conversion button (無料体験レッスン予約 / Book Trial Lesson)"
      },
      "secondary": {
        "background": "{primitives.navy.700}",
        "backgroundHover": "{primitives.navy.800}",
        "text": "#FFFFFF",
        "description": "Secondary action (資料請求 / Request Brochure)"
      },
      "line": {
        "background": "{primitives.lineGreen.base}",
        "backgroundHover": "{primitives.lineGreen.hover}",
        "text": "#FFFFFF",
        "description": "LINE Official Account inquiry button"
      },
      "phone": {
        "background": "{primitives.emerald.600}",
        "backgroundHover": "{primitives.emerald.700}",
        "text": "#FFFFFF",
        "description": "Instant tap-to-call button"
      }
    },
    "badges": {
      "cambridge": {
        "background": "{primitives.navy.100}",
        "text": "{primitives.navy.800}",
        "border": "{primitives.navy.300}"
      },
      "mushouka": {
        "background": "{primitives.amber.100}",
        "text": "{primitives.amber.900}",
        "border": "{primitives.amber.300}"
      },
      "ageRange": {
        "background": "{primitives.slate.200}",
        "text": "{primitives.slate.800}",
        "border": "{primitives.slate.300}"
      }
    }
  }
}
